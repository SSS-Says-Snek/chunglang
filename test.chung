func stuff(param: int64) {
    print(param);
}

func add_one(param: int64) -> int64 {
    let goon = 64;
    if (goon > 5) {
        param + 1
    } else {
        param - 1
    }
}

func aa(param: int64) {
    if (param > 10) {
        stuff(param);
    } else {
        print(add_one(param));
    }
}

func main() {
    aa(6);
}
