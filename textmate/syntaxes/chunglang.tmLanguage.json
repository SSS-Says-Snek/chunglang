{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Chunglang",
  "scopeName": "source.chung",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#variable-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.chung",
          "match": "//.*$"
        },
        {
          "name": "comment.block.chung",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "name": "meta.function.chung",
          "begin": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.chung"
            },
            "2": {
              "name": "entity.name.function.chung"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameter-list"
            }
          ]
        },
        {
          "name": "meta.function.return-type.chung",
          "match": "(->)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.return-type.chung"
            },
            "2": {
              "name": "entity.name.type.chung"
            }
          }
        }
      ]
    },
    "parameter-list": {
      "patterns": [
        {
          "name": "meta.parameter.chung",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.parameter.chung"
            },
            "2": {
              "name": "punctuation.separator.type.chung"
            },
            "3": {
              "name": "entity.name.type.chung"
            }
          }
        },
        {
          "name": "punctuation.separator.parameter.chung",
          "match": ","
        }
      ]
    },
    "variable-declaration": {
      "patterns": [
        {
          "name": "meta.variable.declaration.chung",
          "match": "\\b(let|mut)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.variable.chung"
            },
            "2": {
              "name": "variable.other.declaration.chung"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.chung",
          "match": "\\b(if|else|return|while|for|break|continue|match)\\b"
        },
        {
          "name": "storage.type.variable.chung",
          "match": "\\b(let|mut)\\b"
        },
        {
          "name": "storage.type.function.chung",
          "match": "\\bfunc\\b"
        },
        {
          "name": "constant.language.boolean.chung",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.chung",
          "match": "\\bnil\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.chung",
          "match": "\\b(int64|int32|bool|string|void)\\b"
        },
        {
          "name": "entity.name.type.chung",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.chung",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.chung",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.chung",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.chung",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.chung",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.chung",
          "match": "\\b0[bB][01]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.chung",
          "match": "(\\|\\||&&|!)"
        },
        {
          "name": "keyword.operator.comparison.chung",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.chung",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.chung",
          "match": "="
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "meta.function-call.chung",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.chung"
            }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.chung",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
