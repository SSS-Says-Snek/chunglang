func add_one(param: int64) -> int64 {
    mut example = 3;
    example *= param;
    if (example > 5) {
        example
    } else {
        param - 1
    }
}

func fib(n: int64) -> int64 {
    if (n == 0) {
        0
    } else {
        if (n == 1) {
            1 
        } else {
            if (n == 2) {
                1
            } else {
                fib(n - 1) + fib(n - 2)
            }
        }
    }
}

func aa(param: int64) {
    if (param > 10) {
        print(param);
    } else {
        print(add_one(param));
    }
}

func test_if_exprs(param: int64) {
    print({
        let gurt = param + 1;
        gurt
    });
}

func test_while() {
    mut param = 0;
    while (param < 10) {
        print(param);
        param = param + 1;
    }
}

func gurt() -> int64 {
    if (2 > 1) {
        0
    } else {
        1
    }
    
    676767
}

func main() {
    aa(6);
    test_if_exprs(2);
    print(fib(10));
    print(gurt());
}
