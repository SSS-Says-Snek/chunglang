func clamp(value: int64, min: int64, max: int64) -> int64 {
    if (value < min) {
        min
    } else if (value > max) {
        max
    } else {
        value
    }
}

func check_circle_rect_intersection(circle_x: int64, circle_y: int64, circle_radius: int64, rect_x: int64, rect_y: int64, rect_width: int64, rect_height: int64) -> bool {
    let closest_x = clamp(circle_x, rect_x, rect_x + rect_width);
    let closest_y = clamp(circle_y, rect_y, rect_y + rect_height);

    let distance_x = circle_x - closest_x;
    let distance_y = circle_y - closest_y;
    let distance_squared = distance_x * distance_x + distance_y * distance_y;

    distance_squared < (circle_radius * circle_radius)
}

func main() {
    let SCREEN_WIDTH = 1000;
    let SCREEN_HEIGHT = 620;

    let KEY_ENTER = 257;
    let KEY_ESCAPE = 256;
    let KEY_DOWN = 264;
    let KEY_UP = 265;

    init_window(SCREEN_WIDTH, SCREEN_HEIGHT);
    set_target_fps(60);

    let ball_radius = 20;
    mut ball_x = 500;
    mut ball_y = 310;
    mut ball_speed_x = 9;
    mut ball_speed_y = 9;

    let player_width = 25;
    let player_height = 120;
    let player_speed = 11;
    mut player_x = SCREEN_WIDTH - player_width - 10;
    mut player_y = 310 - 60;

    let cpu_width = 25;
    let cpu_height = 120;
    let cpu_speed = 8;
    mut cpu_x = 10;
    mut cpu_y = 310 - 60;
    mut cpu_current_delay = 0;
    let cpu_reaction_delay = 30;

    mut game_started = false;
    mut game_over = false;

    mut cpu_score = 0;
    mut player_score = 0;

    while (not window_should_close()) {
        if (is_key_pressed(KEY_ENTER)) {
            game_started = true;
        }

        if (game_started and not game_over) {
            begin_drawing();
            clear_background();

            if (is_key_pressed(KEY_ESCAPE)) {
                game_over = true;
            }

            if (not game_over) {
                // Move ball
                ball_x += ball_speed_x;
                ball_y += ball_speed_y;
                if (ball_y + ball_radius > SCREEN_HEIGHT or ball_y - ball_radius < 0) {
                    ball_speed_y *= -1;
                }

                // If hit right edge, CPU wins
                mut reset_ball = if (ball_x + ball_radius > SCREEN_WIDTH) {
                    cpu_score += 1;
                    true
                } else if (ball_x - ball_radius < 0) {
                    player_score += 1;
                    true
                } else {
                    false
                };

                if (reset_ball) {
                    ball_x = 500;
                    ball_y = 310;
                    ball_speed_x = 10;
                    ball_speed_y = 10;
                }

                // Update player
                if (is_key_pressed(KEY_UP)) {
                    player_y -= player_speed;
                }
                if (is_key_pressed(KEY_DOWN)) {
                    player_y += player_speed;
                }

                if (player_y < 0) {
                    player_y = 0;
                } else if (player_y + player_height > SCREEN_HEIGHT) {
                    player_y = SCREEN_HEIGHT - player_height;
                }

                // Update CPU
                if (cpu_current_delay > 0) {
                    cpu_current_delay -= 1;
                } else {
                    if (cpu_y + 60 > ball_y) {
                        cpu_y -= cpu_speed;
                    } else {
                        cpu_y += cpu_speed;
                    }
                    
                    // Limit movement
                    if (cpu_y < 0) {
                        cpu_y = 0;
                    } else if (cpu_y + cpu_height > SCREEN_HEIGHT) {
                        cpu_y = SCREEN_HEIGHT - cpu_height;
                    }
                }

                if (check_circle_rect_intersection(ball_x, ball_y, ball_radius, player_x, player_y, player_width, player_height)) {
                    ball_speed_x *= -1;
                }
                if (check_circle_rect_intersection(ball_x, ball_y, ball_radius, cpu_x, cpu_y, cpu_width, cpu_height)) {
                    ball_speed_x *= -1;
                }

                draw_rectangle(0, 0, 500, SCREEN_HEIGHT, 20, 160, 133);
                draw_rectangle(500, 0, 500, SCREEN_HEIGHT, 38, 185, 154); // GREEN
                draw_circle(500, 310, 150, 129, 204, 184); // LIGHT GREEN
                draw_line(500, 0, 500, SCREEN_HEIGHT, 255, 255, 255); // WHITE

                draw_circle(ball_x, ball_y, ball_radius, 243, 213, 91);
                draw_rectangle(player_x, player_y, player_width, player_height, 255, 255, 255);
                draw_rectangle(cpu_x, cpu_y, cpu_width, cpu_height, 255, 255, 255);

                // Draw scores
                draw_number(250 - 20, 20, cpu_score, 80);
                draw_number(750 - 20, 20, player_score, 80);
            } else {
                if (is_key_pressed(KEY_ENTER)) {
                    game_over = false;
                    game_started = false;
                    player_score = 0;
                    cpu_score = 0;
                }
            }

            end_drawing();
        } else {
            begin_drawing();

            clear_background();

            if (is_key_pressed(KEY_ENTER)) {
                game_started = true;
            }
            end_drawing();
        }
    }

    close_window();
}
