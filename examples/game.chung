func main() {
    let SCREEN_WIDTH = 800;
    let SCREEN_HEIGHT = 600;

    mut ball_x = 100;
    mut ball_y = 100;
    mut ball_speed_x = 5;
    mut ball_speed_y = 5;
    let ball_radius = 15;

    init_window(SCREEN_WIDTH, SCREEN_HEIGHT);
    set_target_fps(60);

    while (not window_should_close()) {
        ball_x = ball_x + ball_speed_x;
        ball_y = ball_y + ball_speed_y;

        if (ball_x + ball_radius > SCREEN_WIDTH or ball_x - ball_radius < 0) {
            ball_speed_x = ball_speed_x * -1;
        }

        if (ball_y + ball_radius > SCREEN_HEIGHT or ball_y - ball_radius < 0) {
            ball_speed_y = ball_speed_y * -1;
        }

        begin_drawing();
        clear_background();
        draw_circle(ball_x, ball_y, ball_radius, 255, 255, 0);
        end_drawing();
    }

    close_window()
}
